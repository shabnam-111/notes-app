# ==========================================
# MindVault Environment Configuration Template
# ==========================================

# -----------------
# Core Infrastructure
# -----------------
POSTGRES_USER=mindvault_admin
POSTGRES_PASSWORD=mindvault_secure_password
POSTGRES_DB=mindvault_db
POSTGRES_PORT=5432

REDIS_PORT=6379

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# -----------------
# Node.js Backend API
# -----------------
NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://mindvault_admin:mindvault_secure_password@localhost:5432/mindvault_db?schema=public
# Use 'postgres:5432' when running inside Docker:
# DATABASE_URL=postgresql://mindvault_admin:mindvault_secure_password@postgres:5432/mindvault_db?schema=public

REDIS_URL=redis://localhost:6379
# Use 'redis://redis:6379' when running inside Docker

JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_67890
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
# Use 'http://ai-service:8000' inside Docker

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# -----------------
# Python AI Microservice
# -----------------
AI_PORT=8000
AI_HOST=0.0.0.0
QDRANT_HOST=localhost
# Use 'qdrant' inside Docker
QDRANT_PORT=6333
QDRANT_COLLECTION=mindvault_vectors

# Embedding Model Options:
# - local: sentence-transformers/all-MiniLM-L6-v2 (default, fast, no external key needed)
# - gemini: text-embedding-004 (requires GEMINI_API_KEY)
# - openai: text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider Options:
# - gemini: Google Gemini (recommended, set GEMINI_API_KEY)
# - openai: OpenAI GPT-4o / GPT-4o-mini (set OPENAI_API_KEY)
# - mock: Deterministic offline mode for zero-key local testing
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# -----------------
# Frontend Application (Next.js)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
PORT=3000
