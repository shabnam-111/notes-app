{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "qdrant"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "qdrant"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "qdrant"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "qdrant"
            }
          }
        ],
        "containers": [
          {
            "name": "qdrant",
            "image": "qdrant/qdrant:latest",
            "ports": [
              {
                "containerPort": 6333
              }
            ],
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/qdrant/storage"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": 6333
              }
            }
          }
        ],
        "enableServiceLinks": false
      }
    }
  }
}
